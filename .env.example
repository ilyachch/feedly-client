# Copy to .env in the project root and fill in real values.
# Real environment variables take precedence over this file.

# Feedly OAuth access token (developer token works too).
FEEDLY_API_KEY=

# Bare Feedly user id, without the "user/" prefix.
FEEDLY_USER_ID=

# Optional: override the data directory (rules.md, logs/, cache/).
# Default: platform user data dir, e.g. ~/.local/share/feedly-client
# FEEDLY_DATA_DIR=
